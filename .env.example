# GEMINI_API_KEY: Required for Gemini AI API and Gemini TTS calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# GOOGLE_TTS_API_KEY: Optional specific Google Cloud Text-to-Speech API key.
# If omitted, GEMINI_API_KEY is used for Google TTS services.
GOOGLE_TTS_API_KEY="MY_GOOGLE_TTS_API_KEY"

# ELEVENLABS_API_KEY: ElevenLabs API Key for high quality multilingual voices.
# Used for secondary provider failover or direct ElevenLabs voice selection.
ELEVENLABS_API_KEY="MY_ELEVENLABS_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"
